<div class="motwm-townie-maker">
  <nav class="tabs" data-group="primary-tabs">
    <a class="item creation-step" data-tab="template">
      <span class="step-number">1</span> Templates
    </a>
    <a class="item creation-step" data-tab="details">
      <span class="step-number">2</span> Details
    </a>
    <a class="item creation-step" data-tab="abilities">
      <span class="step-number">3</span> Abilities
    </a>
    <a class="item creation-step" data-tab="equipment">
      <span class="step-number">4</span> Equipment
    </a>
    <a class="item settings-tab" data-tab="settings">
      <i class="fas fa-cog"></i> Settings
    </a>
  </nav>

  <div class="content">
    <!-- Template Selection Tab -->
    <div class="tab" data-tab="template">
      {{#if showTemplateDetail}}
      <div class="template-detail">
        <button type="button" class="template-detail-back" data-action="template-gallery-back">
          <i class="fas fa-arrow-left"></i> Back to Templates
        </button>
        <header class="template-detail-header">
          <div class="template-detail-icon"><i class="{{selectedTemplateDetail.icon}}"></i></div>
          <div>
            <div class="template-applied"><i class="fas fa-check"></i> Applied to draft</div>
            <h2>{{selectedTemplateDetail.name}}</h2>
            <p>{{selectedTemplateDetail.description}}</p>
          </div>
        </header>
        <div class="template-detail-sections">
          {{#each selectedTemplateDetail.sections}}
          <section class="template-detail-section">
            <h3>{{title}}</h3>
            {{#if rows}}
            <dl>
              {{#each rows}}
              <div><dt>{{label}}</dt><dd>{{value}}</dd></div>
              {{/each}}
            </dl>
            {{/if}}
            {{#if items}}
            <ul>
              {{#each items}}<li>{{this}}</li>{{/each}}
            </ul>
            {{/if}}
          </section>
          {{/each}}
        </div>
      </div>
      {{else}}
      <div class="section-header">Choose a Template</div>

      {{#if templateLoadError}}
      <div class="motwm-template-load-error">
        <div class="motwm-template-load-error__title">
          <i class="fas fa-exclamation-triangle"></i>
          Template load failed
        </div>
        <div class="motwm-template-load-error__body">
          <div><strong>{{templateLoadError.message}}</strong></div>
          <div>Attempted: <code>{{templateLoadError.url}}</code></div>
          {{#if templateLoadError.details}}
          <details>
            <summary>Show error details</summary>
            <pre>{{templateLoadError.details}}</pre>
          </details>
          {{/if}}
          <div class="motwm-template-load-error__hint">
            Fix the JSON and reload Foundry (or refresh the page).
          </div>
        </div>
      </div>
      {{/if}}

      <div class="template-grid">
        {{#each templates}}
        <button type="button" class="template-card {{#if (eq ../selectedTemplate.id this.id)}}selected{{/if}}"
                data-action="select-template"
                data-template-id="{{this.id}}">
          <div class="icon"><i class="{{this.icon}}"></i></div>
          <div class="name">{{this.name}}</div>
          <div class="description">{{this.description}}</div>
        </button>
        {{/each}}
      </div>
      {{/if}}
    </div>

    <!-- Details Tab -->
    <div class="tab" data-tab="details">
      <div class="section-header">NPC Details</div>
      
      <div class="form-group">
        <label for="npc-name">Name *</label>
        <div style="display: flex; gap: 8px; align-items: stretch;">
          <input type="text" id="npc-name" data-field="name" value="{{formData.name}}" placeholder="Enter NPC name" style="flex: 1; min-width: 0;">
          <button data-action="randomize-name" title="Generate Random Name" style="width: 36px; height: 36px; padding: 0; flex-shrink: 0; display: flex; align-items: center; justify-content: center;">
            <i class="fas fa-dice"></i>
          </button>
        </div>
      </div>

      <div style="display: flex; gap: 12px;">
        <div class="form-group" style="flex: 2; min-width: 0;">
          <label for="npc-race">Race</label>
          <select id="npc-race" data-field="race">
            <option value="">-- Select Race --</option>
            {{#each races}}
            <option value="{{this.name}}" {{#if (eq ../formData.race this.name)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-group" style="flex: 2; min-width: 0;">
          <label for="npc-class">Class</label>
          <select id="npc-class" data-field="className">
            <option value="">-- Select Class --</option>
            {{#each classes}}
            <option value="{{this.name}}" {{#if (eq ../formData.className this.name)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="form-group" style="flex: 1; min-width: 80px;">
          <label for="npc-gender">Gender</label>
          <select id="npc-gender" data-field="gender">
            <option value="male" {{#if (eq formData.gender "male")}}selected{{/if}}>Male</option>
            <option value="female" {{#if (eq formData.gender "female")}}selected{{/if}}>Female</option>
          </select>
        </div>
      </div>

      <div style="display: flex; gap: 12px;">
        <div class="form-group" style="flex: 2; min-width: 0;">
          <label for="npc-alignment">Alignment</label>
          <select id="npc-alignment" data-field="alignment">
            <option value="">-- Select Alignment --</option>
            <option value="Lawful Good" {{#if (eq formData.alignment "Lawful Good")}}selected{{/if}}>Lawful Good</option>
            <option value="Neutral Good" {{#if (eq formData.alignment "Neutral Good")}}selected{{/if}}>Neutral Good</option>
            <option value="Chaotic Good" {{#if (eq formData.alignment "Chaotic Good")}}selected{{/if}}>Chaotic Good</option>
            <option value="Lawful Neutral" {{#if (eq formData.alignment "Lawful Neutral")}}selected{{/if}}>Lawful Neutral</option>
            <option value="Neutral" {{#if (eq formData.alignment "Neutral")}}selected{{/if}}>Neutral</option>
            <option value="Chaotic Neutral" {{#if (eq formData.alignment "Chaotic Neutral")}}selected{{/if}}>Chaotic Neutral</option>
            <option value="Lawful Evil" {{#if (eq formData.alignment "Lawful Evil")}}selected{{/if}}>Lawful Evil</option>
            <option value="Neutral Evil" {{#if (eq formData.alignment "Neutral Evil")}}selected{{/if}}>Neutral Evil</option>
            <option value="Chaotic Evil" {{#if (eq formData.alignment "Chaotic Evil")}}selected{{/if}}>Chaotic Evil</option>
          </select>
        </div>

        <div class="form-group" style="flex: 1; min-width: 80px;">
          <label for="npc-level">Level (1-20)</label>
          <input type="number" id="npc-level" data-field="classLevel" value="{{formData.classLevel}}" min="1" max="20" placeholder="1">
        </div>
      </div>

      <div class="form-group">
        <label for="npc-personality">Notes (Optional)</label>
        <textarea id="npc-personality" data-field="personality" rows="3" placeholder="Brief personality description">{{formData.personality}}</textarea>
      </div>

      <div class="form-group">
        <label for="npc-background">Biography (Optional)</label>
        <textarea id="npc-background" data-field="background" rows="3" placeholder="Brief background or history">{{formData.background}}</textarea>
      </div>
    </div>

    <!-- Abilities Tab -->
    <div class="tab" data-tab="abilities">
      <div class="section-header">Ability Scores</div>

      <div class="ability-methods" role="group" aria-label="Ability generation method">
        {{#each abilityMethods}}
        <button type="button" data-action="select-ability-method" data-method="{{id}}" class="ability-method {{#if selected}}selected{{/if}}">
          <i class="{{icon}}"></i>
          <span>{{label}}</span>
        </button>
        {{/each}}
      </div>

      {{#if isPointBuy}}
      <div class="ability-buy-controls">
        <label for="ability-point-budget">Auto Buy Budget</label>
        <select id="ability-point-budget" data-ability-budget>
          {{#each pointBuyBudgets}}
          <option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}} points</option>
          {{/each}}
        </select>
        <span>Higher priorities receive stronger scores; the final ranks become deliberate dump stats.</span>
      </div>
      {{/if}}

      <div class="ability-workspace">
        <section class="ability-priority-panel" aria-labelledby="ability-priority-heading">
          <div class="ability-panel-heading" id="ability-priority-heading">Allocation Priority</div>
          <div class="ability-priority-list">
            {{#each abilityPriorityRows}}
            <div class="ability-priority-row">
              <span class="ability-priority-rank">{{rank}}</span>
              <strong>{{label}}</strong>
              {{#if pinned}}
              <span class="ability-pin"><i class="fas fa-thumbtack"></i> {{allocationNote}}</span>
              {{else}}
              <span class="ability-allocation-note">{{allocationNote}}</span>
              {{/if}}
              <span class="ability-priority-actions">
                <button type="button" data-action="move-ability-priority" data-ability="{{key}}" data-direction="up" title="Move {{label}} higher"><i class="fas fa-chevron-up"></i></button>
                <button type="button" data-action="move-ability-priority" data-ability="{{key}}" data-direction="down" title="Move {{label}} lower"><i class="fas fa-chevron-down"></i></button>
                {{#if pinned}}
                <button type="button" data-action="unpin-ability" data-ability="{{key}}" title="Unpin {{label}} for this draft"><i class="fas fa-unlock"></i></button>
                {{/if}}
              </span>
            </div>
            {{/each}}
          </div>
        </section>

        <section class="ability-score-panel" aria-labelledby="ability-score-heading">
          <div class="ability-panel-heading" id="ability-score-heading">Current Scores</div>
          <div class="abilities-grid">
            {{#each abilities}}
            <div class="ability-input {{#if pinned}}pinned{{/if}}">
              <label for="ability-{{this.key}}">{{this.label}} {{#if pinned}}<i class="fas fa-thumbtack" title="Pinned by template"></i>{{/if}}</label>
              <input type="number" id="ability-{{this.key}}" data-ability="{{this.key}}" value="{{this.value}}">
            </div>
            {{/each}}
          </div>
        </section>
      </div>

      <div class="ability-generation-footer">
        <div class="ability-generation-note">
          {{#if isRollMethod}}
          Current roll pool: <strong>{{abilityRollPool}}</strong>. Reordering assigns the same rolls in the new order.
          {{else}}
          Pinned values stay fixed. Unpinned values follow the priority order.
          {{/if}}
        </div>
        <button type="button" data-action="roll-abilities" {{#if (eq formData.abilityGenerationMethod "manual")}}disabled{{/if}}>
          <i class="fas fa-sync-alt"></i>
          {{#if isRollMethod}}Reroll{{else}}Generate Scores{{/if}}
        </button>
      </div>
      {{#if abilityWarnings}}
      <div class="ability-warnings">
        {{#each abilityWarnings}}<div><i class="fas fa-exclamation-triangle"></i> {{this}}</div>{{/each}}
      </div>
      {{/if}}
    </div>

    <!-- Settings Tab -->
    <div class="tab" data-tab="settings">
      <div class="section-header">Townie Settings</div>
      
      <div class="form-group" style="margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" 
                 data-field="usePcSheet" 
                 {{#if formData.usePcSheet}}checked{{/if}}
                 style="width: 18px; height: 18px;">
          <span style="font-weight: bold;">Use PC Style Sheet</span>
        </label>
        <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: 4px;">
          When enabled, creates full PC sheet with class progression and automatic calculations.<br>
          When disabled, creates simplified NPC sheet with manual HP and level.
        </div>
      </div>
      
      <div class="form-group" style="margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" 
                 data-field="useMaxHpPerHD" 
                 {{#if formData.useMaxHpPerHD}}checked{{/if}}
                 style="width: 18px; height: 18px;">
          <span style="font-weight: bold;">Use Max HP per Hit Die</span>
        </label>
        <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: 4px;">
          When enabled, awards maximum HP per level (e.g. d10 = 10 HP/level).<br>
          When disabled, rolls HP randomly (max at level 1, random for other levels).
        </div>
      </div>

      <div class="section-header">Token Options</div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label style="font-weight: bold; display: block; margin-bottom: 4px;">Token Disposition</label>
        <select data-field="tokenDisposition" style="width: 200px; padding: 4px 8px;">
          <option value="1" {{#if (eq formData.tokenDisposition 1)}}selected{{/if}}>Friendly</option>
          <option value="0" {{#if (eq formData.tokenDisposition 0)}}selected{{/if}}>Neutral</option>
          <option value="-1" {{#if (eq formData.tokenDisposition -1)}}selected{{/if}}>Hostile</option>
        </select>
        <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-top: 4px;">
          Sets the default disposition for placed tokens.
        </div>
      </div>
    </div>

    <!-- Equipment Tab -->
    <div class="tab" data-tab="equipment">
      <div class="section-header">Equipment and Wealth</div>

      <div class="section-header">Budget Options</div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label style="font-weight: bold; display: block; margin-bottom: 8px;">Wealth Mode</label>
        <div style="display: grid; gap: 8px;">
          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio"
                   name="budgetMode"
                   data-field="budgetMode"
                   value="standardBudget"
                   {{#if (eq formData.budgetMode "standardBudget")}}checked{{/if}}
                   style="width: 18px; height: 18px;">
            <span style="font-weight: bold;">Standard Adventurer Budget</span>
          </label>
          <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: -2px;">
            Uses wealth-by-level appropriate gear and magic items.
          </div>

          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio"
                   name="budgetMode"
                   data-field="budgetMode"
                   value="npcWealth"
                   {{#if (eq formData.budgetMode "npcWealth")}}checked{{/if}}
                   style="width: 18px; height: 18px;">
            <span style="font-weight: bold;">NPC Gear Value</span>
          </label>
          <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: -2px;">
            Uses the lower NPC gear value table instead of PC wealth-by-level.
          </div>

          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
            <input type="radio"
                   name="budgetMode"
                   data-field="budgetMode"
                   value="noBudget"
                   {{#if (eq formData.budgetMode "noBudget")}}checked{{/if}}
                   style="width: 18px; height: 18px;">
            <span style="font-weight: bold;">No Budget</span>
          </label>
          <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: -2px;">
            Disables automatic gear and magic items, leaving only token gold as loot.
          </div>
        </div>
      </div>

      <div class="section-header">Loot Options</div>
      
      <div class="form-group" style="margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" 
                 data-field="identifyItems" 
                 {{#if formData.identifyItems}}checked{{/if}}
                 style="width: 18px; height: 18px;">
          <span style="font-weight: bold;">Identify Magic Items</span>
        </label>
        <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: 4px;">
          When enabled, magic items are identified and show their full names.<br>
          When disabled, items appear unidentified (suitable for loot drops).
        </div>
      </div>
      
      <div class="form-group" style="margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" 
                 data-field="extraMoneyInBank" 
                 {{#if formData.extraMoneyInBank}}checked{{/if}}
                 style="width: 18px; height: 18px;">
          <span style="font-weight: bold;">Extra Money in the Bank</span>
        </label>
        <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: 4px;">
          When enabled, excess gold becomes a bank deposit slip with only pocket change remaining.<br>
          When disabled, all remaining gold is given as coins.
        </div>
        <div style="margin-left: 26px; margin-top: 8px;">
          <label style="font-size: 12px; font-weight: bold; display: block; margin-bottom: 4px;">Reserve Gold For Cash/Deposit (%)</label>
          <input type="range"
                 data-field="reserveGoldPercent"
                 min="0"
                 max="100"
                 step="1"
                 value="{{formData.reserveGoldPercent}}"
                 style="width: 100%; max-width: 300px;">
          <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-top: 4px;">
            Current reserve: <strong>{{formData.reserveGoldPercent}}%</strong> of post-mundane budget.
          </div>

          <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; margin-top: 10px;">
            <input type="checkbox"
                   data-field="keepPocketChange"
                   {{#if formData.keepPocketChange}}checked{{/if}}
                   style="width: 18px; height: 18px;">
            <span style="font-size: 12px; font-weight: bold;">Keep Pocket Change</span>
          </label>
          <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-top: 2px;">
            When enabled, keep some coins on-hand and deposit the rest.
            When disabled, all reserved remainder goes to bank deposit.
          </div>

          <label style="font-size: 12px; font-weight: bold; display: block; margin-bottom: 4px;">Bank Name</label>
          <input type="text" 
                 data-field="bankName" 
                 value="{{formData.bankName}}"
                 placeholder="The First Bank of Lower Everbrook"
                 style="width: 100%; max-width: 300px; padding: 4px 8px; font-size: 12px;">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 16px;">
        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
          <input type="checkbox" 
                 data-field="includeLootPacks" 
                 {{#if formData.includeLootPacks}}checked{{/if}}
                 style="width: 18px; height: 18px;">
          <span style="font-weight: bold;">Include SRD Loot Pack</span>
        </label>
        <div style="font-size: 11px; color: var(--color-text-dark-6, #3b3f4a); margin-left: 26px; margin-top: 4px;">
          When enabled, adds random SRD treasure (coins, gems, items) appropriate to the NPC's level<br>
          using D35E's built-in treasure tables. This is in addition to the NPC's equipped gear.
        </div>
      </div>

      {{#unless (eq formData.budgetMode "noBudget")}}
      <div class="section-header" style="margin-top: 20px;">Magic Item Budget Allocation</div>
      <div class="budget-intro">
        Choose a spending strategy. Percentages are Townie Maker recommendations, not official D&amp;D rules.
      </div>

      {{#unless budgetInfo}}
      <div style="background: rgba(0,0,0,0.2); padding: 8px; margin-bottom: 12px; border-radius: 4px; font-size: 12px;">
        <strong>Tip:</strong> Select a <strong>Class</strong> and <strong>Level</strong> on the Details tab to show the full wealth and GP budget breakdown.
      </div>
      {{/unless}}

      <div class="budget-presets" role="group" aria-label="Spending strategy">
        {{#each spendingPresets}}
        <button type="button" data-action="select-spending-preset" data-preset="{{id}}" class="budget-preset {{#if selected}}selected{{/if}}">
          {{label}}
        </button>
        {{/each}}
      </div>

      {{#if budgetInfo}}
      <div class="budget-ledger">
        <div><span>Total wealth</span><strong>{{budgetInfo.totalWealth}} gp</strong></div>
        <div><span>Mundane kit</span><strong>{{budgetInfo.mundaneCost}} gp</strong></div>
        <div><span>Reserved cash</span><strong>{{budgetInfo.reservedGp}} gp</strong></div>
        <div class="budget-ledger__total"><span>Magic-item budget</span><strong>{{budgetInfo.spendableGp}} gp</strong></div>
      </div>

      <button type="button" data-action="toggle-advanced-spending" class="budget-advanced-toggle">
        <i class="fas fa-sliders-h"></i>
        {{#if budgetInfo.showAdvanced}}Hide detailed plan{{else}}Show detailed plan{{/if}}
      </button>

      {{#if budgetInfo.showAdvanced}}
      <section class="budget-scale-section">
        <div>
          <strong>Wealth Scale</strong>
          <span>Scales total wealth before equipment allocation. It is not part of a 100% mix.</span>
        </div>
        <label>
          Wealth multiplier
          <span><input type="number" data-spending-multiplier min="0" max="200" step="5" value="{{budgetInfo.multiplierPercent}}">%</span>
        </label>
      </section>

      <div class="budget-subheading">Item Mixes <span>Each group independently divides one parent category.</span></div>
      <div class="budget-split-groups">
        {{#each budgetInfo.splitGroups}}
        <section class="budget-split-group {{#unless valid}}incomplete{{/unless}}">
          <header>
            <div>
              <strong>{{label}}</strong>
              <span>% of {{parent}}</span>
            </div>
            <div class="budget-split-total {{#unless valid}}invalid{{/unless}}">
              {{totalPercent}}% total
              {{#unless valid}}<span>{{remainingPercent}}% unassigned</span>{{/unless}}
            </div>
          </header>
          <div class="budget-split-members">
            {{#each members}}
            <label class="budget-split-member {{#if invalid}}invalid{{/if}}">
              <span>{{label}}</span>
              <span class="budget-split-input">
                <input type="number"
                       data-spending-split="{{key}}"
                       data-spending-group="{{../key}}"
                       min="0"
                       max="{{maxPercent}}"
                       step="1"
                       value="{{percent}}"
                       {{#if invalid}}aria-invalid="true"{{/if}}>%
              </span>
              {{#if message}}<small>{{message}}</small>{{/if}}
            </label>
            {{/each}}
          </div>
        </section>
        {{/each}}
      </div>

      <div class="budget-subheading budget-overall-heading">
        {{budgetInfo.categoryHeading}}
        <span>All enabled category shares total {{budgetInfo.overallCategoryTotal}}%.</span>
      </div>
      <div class="budget-category-list">
        <div class="budget-category-list__header">
          <span>Use</span><span>Priority</span><span>Category</span><span>Share</span><span>Rollover cap</span><span>Item limit</span><span>Budget</span>
        </div>
        {{#each budgetInfo.categories}}
        <div class="budget-category-row">
          <input type="checkbox" data-spending-enabled="{{key}}" {{#if enabled}}checked{{/if}} aria-label="Use {{label}}">
          <span class="budget-priority-controls">
            <button type="button" data-action="move-spending-category" data-category="{{key}}" data-direction="up" title="Move {{label}} earlier"><i class="fas fa-chevron-up"></i></button>
            <button type="button" data-action="move-spending-category" data-category="{{key}}" data-direction="down" title="Move {{label}} later"><i class="fas fa-chevron-down"></i></button>
          </span>
          <strong>{{label}}</strong>
          <span><input type="number" data-spending-share="{{key}}" min="0" max="100" step="1" value="{{percent}}">%</span>
          <span><input type="number" data-spending-cap="{{key}}" min="0" max="100" step="5" value="{{maxPercent}}">%</span>
          <input type="number" data-spending-item-limit="{{key}}" min="0" max="100" step="1" value="{{itemLimit}}" placeholder="Auto" aria-label="{{label}} item limit">
          <span>{{allocatedGp}} gp</span>
        </div>
        {{/each}}
      </div>
      <p class="budget-rollover-note">Unused money follows this priority order. Each category accepts rollover up to its cap; anything left after the final category becomes cash.</p>
      {{/if}}
      {{/if}}
      {{/unless}}
    </div>
  </div>

  <footer class="wizard-footer">
    <div class="wizard-footer-slot wizard-footer-left">
      <button type="button" data-action="cancel" data-footer-action="cancel" {{#unless wizardFooter.showCancel}}hidden{{/unless}}>
      <i class="fas fa-times"></i> Cancel
      </button>
      <button type="button" data-action="wizard-back" data-footer-action="back" {{#unless wizardFooter.showBack}}hidden{{/unless}}>
        <i class="fas fa-arrow-left"></i> Back
      </button>
    </div>
    <div class="wizard-footer-slot wizard-footer-center">
      <button type="button" data-action="create-npc" data-footer-action="createNow" {{#unless wizardFooter.showCreateNow}}hidden{{/unless}}>
        <i class="fas fa-user-plus"></i> Create Now
      </button>
    </div>
    <div class="wizard-footer-slot wizard-footer-right">
      <button type="button" class="primary" data-action="wizard-next" data-footer-action="next" {{#if wizardFooter.nextDisabled}}disabled{{/if}} {{#unless wizardFooter.showNext}}hidden{{/unless}}>
        Next <i class="fas fa-arrow-right"></i>
      </button>
      <button type="button" class="primary" data-action="create-npc" data-footer-action="finalCreate" {{#unless wizardFooter.showFinalCreate}}hidden{{/unless}}>
        <i class="fas fa-user-plus"></i> Create Townie
      </button>
      <button type="button" data-action="return-to-flow" data-footer-action="returnToFlow" {{#unless wizardFooter.showReturnToFlow}}hidden{{/unless}}>
        <i class="fas fa-arrow-left"></i> <span data-return-label>{{wizardFooter.returnLabel}}</span>
      </button>
    </div>
  </footer>

  <!-- Loading Overlay -->
  <div class="loading-overlay" style="display: none;">
    <div class="loading-content">
      <i class="fas fa-spinner fa-spin loading-spinner"></i>
      <div class="loading-title">Creating NPC...</div>
      <div class="loading-step"></div>
      <div class="loading-progress">
        <div class="loading-progress-bar"></div>
      </div>
    </div>
  </div>
</div>
